export top.potmot.entity.database.DbDatabase

input DatabaseInsertInput {
    #allScalars
    -id
}

input DatabaseUpdateInput {
    #allScalars
    id!
}

DatabaseView {
    #allScalars
    -username
    -password
}

DatabaseConnectionView {
    type
    url
    username
    password
}

specification DatabaseSpec {
    like/i(name)
    type
}
