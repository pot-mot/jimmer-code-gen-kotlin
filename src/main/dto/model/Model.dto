export top.potmot.entity.model.Model

input ModelInsertInput {
    #allScalars
    -id
    -createdTime
    -modifiedTime
}

input ModelUpdateInput {
    #allScalars
    id!
    -createdTime
    -modifiedTime
}

ModelView {
    #allScalars
}

ModelNoJsonView {
    #allScalars
    -jsonData
}

specification ModelSpec {
    like/i(name)
    like/i(description)
    ge(createdTime)
    le(createdTime)
    ge(modifiedTime)
    le(modifiedTime)
    databaseType
}
